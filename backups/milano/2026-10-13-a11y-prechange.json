      "raw": "<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#091746\",\"text\":\"#FFFFFF\"},\"spacing\":{\"padding\":{\"top\":\"48px\",\"bottom\":\"42px\",\"left\":\"24px\",\"right\":\"24px\"}}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1150px\"}} -->\n<div class=\"wp-block-group alignfull has-text-color has-background\" style=\"color:#FFFFFF;background-color:#091746;padding-top:48px;padding-right:24px;padding-bottom:42px;padding-left:24px\">\n<!-- wp:columns --><div class=\"wp-block-columns\">\n<!-- wp:column {\"width\":\"48%\"} --><div class=\"wp-block-column\" style=\"flex-basis:48%\">\n<!-- wp:heading {\"level\":3,\"style\":{\"color\":{\"text\":\"#F5C04A\"}}} --><h3 class=\"wp-block-heading\" style=\"color:#F5C04A\">ULUSLARARASI MILANO SİRKİ</h3><!-- /wp:heading -->\n<!-- wp:paragraph --><p>Akrobasi, denge ve eğlenceli performanslarla Türkiye turnesi. Programlarımız için hazırlık sürüyor.</p><!-- /wp:paragraph -->\n<!-- wp:paragraph {\"fontSize\":\"small\"} --><p class=\"has-small-font-size\">Organizasyon: Dünya Organizasyon</p><!-- /wp:paragraph -->\n</div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\">\n<!-- wp:heading {\"level\":3,\"style\":{\"color\":{\"text\":\"#F5C04A\"}}} --><h3 class=\"wp-block-heading\" style=\"color:#F5C04A\">İletişim</h3><!-- /wp:heading -->\n<!-- wp:paragraph --><p><a style=\"color:#F5C04A;text-decoration:underline;text-underline-offset:4px;display:inline-flex;align-items:center;min-height:44px;padding:7px 12px;box-sizing:border-box\" href=\"mailto:milanosirki@gmail.com\">milanosirki@gmail.com</a></p><!-- /wp:paragraph -->\n<!-- wp:paragraph --><p><strong>WhatsApp:</strong> <a style=\"color:#F5C04A;text-decoration:underline;text-underline-offset:4px;display:inline-flex;align-items:center;min-height:44px;padding:7px 12px;box-sizing:border-box\" href=\"https://wa.me/905363583381\" target=\"_blank\" rel=\"noopener noreferrer\">0536 358 33 81</a></p><!-- /wp:paragraph -->\n<!-- wp:paragraph --><p><a style=\"color:#F5C04A;text-decoration:underline;text-underline-offset:4px;display:inline-flex;align-items:center;min-height:44px;padding:7px 12px;box-sizing:border-box\" href=\"https://www.instagram.com/milanosirkiturkiye/\" target=\"_blank\" rel=\"noopener noreferrer\">Instagram: @milanosirkiturkiye</a></p><!-- /wp:paragraph -->\n<!-- wp:paragraph {\"fontSize\":\"small\"} --><p class=\"has-small-font-size\">Bilet satışları bu sitede henüz aktif değildir.</p><!-- /wp:paragraph -->\n</div><!-- /wp:column -->\n</div><!-- /wp:columns -->\n<!-- wp:paragraph {\"align\":\"center\",\"fontSize\":\"small\"} --><p class=\"has-text-align-center has-small-font-size\"><a style=\"color:#F5C04A;text-decoration:underline;text-underline-offset:4px;display:inline-flex;align-items:center;min-height:44px;padding:7px 12px;box-sizing:border-box\" href=\"/kvkk-aydinlatma-metni/\">KVKK Aydınlatma Metni</a> &nbsp;·&nbsp; <a style=\"color:#F5C04A;text-decoration:underline;text-underline-offset:4px;display:inline-flex;align-items:center;min-height:44px;padding:7px 12px;box-sizing:border-box\" href=\"/gizlilik-politikasi/\">Gizlilik Politikası</a> &nbsp;·&nbsp; <a style=\"color:#F5C04A;text-decoration:underline;text-underline-offset:4px;display:inline-flex;align-items:center;min-height:44px;padding:7px 12px;box-sizing:border-box\" href=\"/cerez-politikasi/\">Çerez Politikası</a></p><!-- /wp:paragraph -->\n<!-- wp:separator {\"style\":{\"color\":{\"background\":\"#F5C04A\"}}} --><hr class=\"wp-block-separator has-text-color has-alpha-channel-opacity has-background\" style=\"background-color:#F5C04A;color:#F5C04A\"/><!-- /wp:separator -->\n<!-- wp:paragraph {\"align\":\"center\",\"fontSize\":\"small\"} --><p class=\"has-text-align-center has-small-font-size\">© 2026 Uluslararası Milano Sirki · milanosirki.com</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->",
